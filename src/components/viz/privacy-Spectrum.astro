---
/**
 * privacy-Spectrum — a horizontal spectrum from "collect everything" to
 * "collect minimum," showing how Waev handles four categories of data today,
 * ordered from most kept to least kept:
 *   raw frames (archived whole, public route) · companion device type + GPS
 *   (kept in analytics rows ~90 days) · signal metadata (kept) · companion
 *   name + public key (blanked at ingest).
 * Facts: waev src/handlers/ingest.ts (archivePacketRaw; AE_DECODED write) and
 * src/handlers/packet-search.ts (GET /packets/:hash/raw).
 * Theme-aware via CSS custom properties.
 */
---

<svg viewBox="0 0 720 200" role="img" aria-label="Data collection spectrum from 'collect everything' on the left to 'collect minimum' on the right, with how Waev handles four categories today: raw frames are archived whole and served on a public route; companion device types and GPS coordinates are kept in analytics rows for about 90 days; signal metadata — SNR, hops, timing — is kept; companion names and public keys are blanked at ingest." style="width:100%;height:auto;">
  <!-- Spectrum bar: red on left, accent on right -->
  <rect x="40" y="66" width="640" height="10" rx="5" style="fill: var(--border-subtle);" />
  <!-- Red segment (collect everything zone) -->
  <rect x="40" y="66" width="200" height="10" rx="5" style="fill: var(--sys-red-400); opacity: 0.5;" />
  <!-- Accent segment (collect minimum zone) -->
  <rect x="540" y="66" width="140" height="10" rx="5" style="fill: var(--accent); opacity: 0.6;" />

  <!-- Left label -->
  <text x="40" y="56" class="viz-label" style="fill: var(--sys-red-400); opacity:0.8;">collect everything</text>
  <!-- Right label -->
  <text x="680" y="56" text-anchor="end" class="viz-label" style="fill: var(--accent-light);">collect minimum</text>

  <!-- Data categories, most kept → least kept -->
  <!-- Category 1: raw frames — archived whole -->
  <g transform="translate(50, 100)">
    <rect x="0" y="0" width="140" height="50" rx="8" style="fill: transparent; stroke: var(--sys-red-400); opacity:0.5;" stroke-width="1" stroke-dasharray="4 3" />
    <text x="70" y="16" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:10px;">raw frames</text>
    <text x="70" y="32" text-anchor="middle" style="fill: var(--sys-red-400); font-family: var(--mono); font-size: 11px; font-weight: 600;">archived</text>
    <text x="70" y="46" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:9px; font-style:italic;">whole · public route</text>
  </g>

  <!-- Category 2: companion device type + GPS — kept -->
  <g transform="translate(210, 100)">
    <rect x="0" y="0" width="140" height="50" rx="8" style="fill: transparent; stroke: var(--sys-red-400); opacity:0.4;" stroke-width="1" stroke-dasharray="4 3" />
    <text x="70" y="16" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:10px;">companion type · gps</text>
    <text x="70" y="32" text-anchor="middle" style="fill: var(--sys-red-400); font-family: var(--mono); font-size: 11px; font-weight: 600;">kept</text>
    <text x="70" y="46" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:9px; font-style:italic;">analytics · ~90 days</text>
  </g>

  <!-- Category 3: signal metadata — kept -->
  <g transform="translate(390, 100)">
    <rect x="0" y="0" width="140" height="50" rx="8" style="fill: var(--accent-subtle); stroke: var(--border-accent);" stroke-width="1" />
    <text x="70" y="16" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:10px;">SNR · hops · timing</text>
    <text x="70" y="32" text-anchor="middle" style="fill: var(--accent-light); font-family: var(--mono); font-size: 11px; font-weight: 600;">kept</text>
    <text x="70" y="46" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:9px; font-style:italic;">signal metadata</text>
  </g>

  <!-- Category 4: companion name + public key — blanked -->
  <g transform="translate(550, 100)">
    <rect x="0" y="0" width="140" height="50" rx="8" style="fill: var(--accent-subtle); stroke: var(--border-accent);" stroke-width="1" />
    <text x="70" y="16" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:10px;">companion name · key</text>
    <text x="70" y="32" text-anchor="middle" style="fill: var(--accent-light); font-family: var(--mono); font-size: 11px; font-weight: 600;">blanked</text>
    <text x="70" y="46" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size:9px; font-style:italic;">at ingest · ADVERTs</text>
  </g>
</svg>
