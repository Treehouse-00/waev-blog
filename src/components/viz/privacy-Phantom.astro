---
/**
 * privacy-Phantom — a companion ADVERT as an observer hears it (the frame the
 * raw archive keeps whole) vs. the analytics row Waev writes after the ingest
 * scrub. Left panel: every field the frame carries. Right panel: name and
 * public key blanked; device type, GPS coordinates, and signal metadata kept.
 * Facts: waev src/handlers/ingest.ts (AE_DECODED blob4/blob6/blob9 scrubbed,
 * double4–6 kept; archivePacketRaw stores the full frame).
 * Theme-aware via CSS custom properties.
 */
---

<svg viewBox="0 0 720 280" role="img" aria-label="Two records for the same companion device. Left: the ADVERT as an observer hears it — name, public key, device type, GPS coordinates, SNR, hops — which the raw-frame archive keeps whole. Right: the analytics row after the ingest scrub — name and public key are blanked; device type, GPS coordinates, SNR, and hops are kept." style="width:100%;height:auto;">
  <defs>
    <marker id="priv-ph-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" style="fill: var(--text-muted);" />
    </marker>
  </defs>

  <!-- Left panel: the ADVERT as heard (kept whole in the raw archive) -->
  <text x="170" y="24" text-anchor="middle" class="viz-label"
    style="fill: var(--text-muted); letter-spacing: 0.06em;">THE ADVERT AS HEARD</text>

  <rect x="20" y="32" width="300" height="220" rx="12"
    style="fill: var(--surface-1); stroke: var(--border-subtle);"
    stroke-width="1" />

  <!-- Record header -->
  <text x="40" y="58" style="fill: var(--text-muted); font-family: var(--font); font-size: 12px; font-weight: 600;">companion_advert</text>
  <line x1="40" y1="68" x2="300" y2="68" style="stroke: var(--border-subtle);" stroke-width="0.8" />

  <!-- Fields carried by the frame -->
  <text x="40" y="92" class="viz-label" style="fill: var(--text-muted);">name</text>
  <text x="300" y="92" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px;">Pixel-7a</text>

  <text x="40" y="120" class="viz-label" style="fill: var(--text-muted);">public_key</text>
  <text x="300" y="120" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px;">3F9A…C21E</text>

  <text x="40" y="148" class="viz-label" style="fill: var(--text-muted);">device_type</text>
  <text x="300" y="148" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px;">companion</text>

  <text x="40" y="176" class="viz-label" style="fill: var(--text-muted);">gps</text>
  <text x="300" y="176" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px;">47.61, −122.33</text>

  <text x="40" y="204" class="viz-label">snr</text>
  <text x="300" y="204" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px;">8.5 dB</text>

  <text x="40" y="232" class="viz-label">hops</text>
  <text x="300" y="232" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px;">2</text>

  <!-- "kept whole" label -->
  <text x="170" y="270" text-anchor="middle" class="viz-label" style="fill: var(--text-muted); font-size: 10px;">kept whole in the public raw-frame archive</text>

  <!-- Arrow: scrub -->
  <line x1="334" y1="142" x2="378" y2="142" style="stroke: var(--text-tertiary);" stroke-width="1.5" marker-end="url(#priv-ph-arrow)" />
  <text x="356" y="134" text-anchor="middle" class="viz-label" style="fill: var(--text-accent);">scrub</text>
  <text x="356" y="154" text-anchor="middle" class="viz-label" style="fill: var(--text-accent);">@ ingest</text>

  <!-- Right panel: the analytics row -->
  <text x="549" y="24" text-anchor="middle" class="viz-label"
    style="fill: var(--accent-light); letter-spacing: 0.06em;">THE ANALYTICS ROW</text>

  <rect x="392" y="32" width="300" height="220" rx="12"
    style="fill: var(--surface-1); stroke: var(--border-accent);"
    stroke-width="1" />

  <!-- Record header -->
  <text x="412" y="58" style="fill: var(--text); font-family: var(--font); font-size: 12px; font-weight: 600;">analytics_row</text>
  <line x1="412" y1="68" x2="672" y2="68" style="stroke: var(--border-subtle);" stroke-width="0.8" />

  <!-- Blanked identity fields -->
  <text x="412" y="92" class="viz-label" style="fill: var(--text-muted); opacity: 0.4;">name</text>
  <text x="672" y="92" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px; opacity: 0.4;">—</text>

  <text x="412" y="120" class="viz-label" style="fill: var(--text-muted); opacity: 0.4;">public_key</text>
  <text x="672" y="120" text-anchor="end" style="fill: var(--text-muted); font-family: var(--mono); font-size: 12px; opacity: 0.4;">—</text>

  <!-- Kept fields -->
  <text x="412" y="148" class="viz-label">device_type</text>
  <text x="672" y="148" text-anchor="end" style="fill: var(--accent-light); font-family: var(--mono); font-size: 12px;">companion ✓</text>

  <text x="412" y="176" class="viz-label">gps</text>
  <text x="672" y="176" text-anchor="end" style="fill: var(--accent-light); font-family: var(--mono); font-size: 12px;">47.61, −122.33 ✓</text>

  <text x="412" y="204" class="viz-label">snr</text>
  <text x="672" y="204" text-anchor="end" style="fill: var(--accent-light); font-family: var(--mono); font-size: 12px;">8.5 dB ✓</text>

  <text x="412" y="232" class="viz-label">hops</text>
  <text x="672" y="232" text-anchor="end" style="fill: var(--accent-light); font-family: var(--mono); font-size: 12px;">2 ✓</text>

  <!-- Summary label -->
  <text x="549" y="270" text-anchor="middle" class="viz-label" style="fill: var(--text-accent); font-size: 10px;">name and key blanked · type and GPS kept ~90 days</text>
</svg>
