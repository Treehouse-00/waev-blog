---
/**
 * byob-Credentials — the observer credential model.
 * Left side: OBSERVER CREDENTIAL shows the single publish-only credential
 *   Waev issues to an enrolled observer — scoped to its own topic only.
 * Right side: what that credential cannot do (subscribe, write elsewhere,
 *   administer the broker) — the scope is narrow by construction, not by
 *   an operator-configured policy.
 * Theme-aware via CSS custom properties.
 */
const restrictions = [
  { label: "cannot subscribe",       note: "no read access to other streams",  color: "var(--sys-orangeyellow-600)" },
  { label: "cannot write elsewhere", note: "scoped to this observer's topic",  color: "var(--sys-orangeyellow-600)" },
  { label: "cannot administer",      note: "no broker-level access at all",    color: "var(--sys-orangeyellow-600)" },
];
---

<svg viewBox="0 0 720 220" role="img" aria-label="Observer credential model. Waev issues each enrolled observer a publish-only credential to mqtt.waev.app, scoped to that observer's own topic. The credential cannot subscribe to other streams, cannot write anywhere else, and cannot administer the broker." style="width:100%;height:auto;">
  <defs>
    <marker id="byob-cr-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" style="fill: var(--border-hover);" />
    </marker>
  </defs>

  <!-- Left: Observer credential panel -->
  <rect x="20" y="20" width="300" height="180" rx="14"
    style="fill: var(--surface-1); stroke: var(--border-accent);"
    stroke-width="1.5" />
  <text x="170" y="46" text-anchor="middle" class="viz-label"
    style="fill: var(--text-accent); letter-spacing: 0.06em;">OBSERVER CREDENTIAL</text>
  <line x1="40" y1="56" x2="300" y2="56" style="stroke: var(--border-subtle);" stroke-width="0.8" />

  <!-- Credential rows -->
  <!-- The observer's own publish-only credential -->
  <text x="50" y="78" class="viz-label">your observer</text>
  <text x="190" y="78" class="viz-label" style="fill: var(--accent-light);">publish-only</text>
  <rect x="266" y="68" width="42" height="16" rx="4"
    style="fill: var(--accent-subtle); stroke: var(--border-accent);"
    stroke-width="0.8" />
  <text x="287" y="80" text-anchor="middle" class="viz-label" style="fill: var(--accent-light);">pub</text>

  <line x1="40" y1="92" x2="300" y2="92" style="stroke: var(--border-subtle);" stroke-width="0.5" />

  <!-- Scope: its own topic only -->
  <text x="50" y="112" class="viz-label">scope</text>
  <text x="190" y="112" class="viz-label">its own topic only</text>

  <line x1="40" y1="126" x2="300" y2="126" style="stroke: var(--border-subtle);" stroke-width="0.5" />

  <!-- Destination -->
  <text x="50" y="146" class="viz-label" style="opacity: 0.7;">destination: mqtt.waev.app</text>

  <!-- Border bottom / footer -->
  <line x1="40" y1="160" x2="300" y2="160" style="stroke: var(--border-subtle);" stroke-width="0.8" />
  <text x="170" y="178" text-anchor="middle" style="fill: var(--text-muted); font-family: var(--mono); font-size: 11px;">issued by Waev at enrollment</text>
  <text x="170" y="192" text-anchor="middle" class="viz-label">sends its own data, nothing else</text>

  <!-- Divider -->
  <line x1="338" y1="20" x2="338" y2="200" style="stroke: var(--border-subtle);" stroke-width="1" />

  <!-- Right: Restrictions panel -->
  <text x="530" y="38" text-anchor="middle" class="viz-label"
    style="fill: var(--text-accent); letter-spacing: 0.06em;">WHAT IT CANNOT DO</text>

  {restrictions.map((r, i) => (
    <g transform={`translate(364, ${58 + i * 54})`}>
      <rect x="0" y="0" width="330" height="38" rx="8"
        style={`fill: var(--surface-1); stroke: ${r.color}; opacity: 0.9;`}
        stroke-width="1" />
      <text x="16" y="15" style={`fill: ${r.color}; font-family: var(--mono); font-size: 11px; font-weight: 600;`}>
        {r.label}
      </text>
      <text x="16" y="30" class="viz-label">{r.note}</text>
    </g>
  ))}
</svg>
